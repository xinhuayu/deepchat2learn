# Copy this file to .env in the project root (next to package.json).
# Put your real OpenAI API key only in a local .env file after OPENAI_API_KEY=.
# Never put a real key in this template, public/, a ZIP, or source control.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_TEXT_TIMEOUT_MS=120000
OPENAI_SOURCE_DIGEST_TIMEOUT_MS=300000
# Audio/voice model is deliberately separate from the text-understanding model.
OPENAI_AUDIO_MODEL=gpt-realtime-mini
# Backward-compatible alias used only when OPENAI_AUDIO_MODEL is blank.
OPENAI_REALTIME_MODEL=
OPENAI_REALTIME_TIMEOUT_MS=120000
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Voice interaction timing. These values can be increased for slower networks or longer answers.
VOICE_AUTO_SUBMIT_DELAY_MS=5000
VOICE_TRANSITION_DELAY_MS=750
VOICE_REALTIME_SILENCE_MS=5000
VOICE_REALTIME_WATCHDOG_MS=0
VOICE_MAX_RECOGNITION_RETRIES=8
VOICE_MAX_TRANSCRIPT_CHARACTERS=12000
# Optional: leave blank for in-memory sessions. Set a path only when persistence is intentional.
SQLITE_PATH=
# Optional enhancement only. Leave blank for a portable distribution.
# Set this to the full path of the host's own python.exe when richer PDF extraction is needed.
# The executable should have the optional PDF packages installed, including pdfplumber.
DEEPCHAT2LEARN_PYTHON_BIN=
PORT=3000
RATE_LIMIT_PER_MINUTE=120
MAX_ANSWER_CHARACTERS=12000
MAX_QUESTION_CHARACTERS=2000
MAX_REQUEST_BODY_BYTES=28000000
SESSION_RETENTION_MODE=session
SESSION_TTL_MS=3600000
SESSION_SHORT_EXPIRY_MS=900000
SESSION_TURN_BUDGET=50
SESSION_MODEL_TOKEN_BUDGET=120000
MAX_SOURCE_FILES=10
MAX_SOURCE_FILE_BYTES=20000000
MAX_SOURCE_COMBINED_BYTES=50000000
MAX_SOURCE_PAGES=300
MAX_SOURCE_WORDS=150000
MAX_PASTED_SOURCE_CHARACTERS=200000
EXTERNAL_RESEARCH_ENABLED=false
EXTERNAL_RESEARCH_PROVIDER=none
EXTERNAL_RESEARCH_TIMEOUT_MS=4000
EXTERNAL_RESEARCH_CONSENT_TTL_MS=60000
