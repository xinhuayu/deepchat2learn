# Copy this file to .env in the project root (next to package.json).
# Put your real OpenAI API key only in a local .env file after OPENAI_API_KEY=.
# Never put a real key in this template, public/, a ZIP, or source control.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5-mini
# Interactive turns allow provider latency while still falling back locally on a deadline.
OPENAI_TEXT_TIMEOUT_MS=45000
# Source digestion has an independent patient deadline for larger structured evidence responses.
OPENAI_SOURCE_DIGEST_TIMEOUT_MS=180000
# Structured source digests can use a larger completion allowance than short coaching turns.
OPENAI_SOURCE_DIGEST_MAX_OUTPUT_TOKENS=12000
# Prepared source-gist answers use this separate output allowance; raw documents are not resent after digestion.
OPENAI_SOURCE_CONVERSATION_MAX_OUTPUT_TOKENS=3300
# Audio/voice model is deliberately separate from the text-understanding model.
OPENAI_AUDIO_MODEL=gpt-realtime-mini
# Backward-compatible alias used only when OPENAI_AUDIO_MODEL is blank.
OPENAI_REALTIME_MODEL=
OPENAI_REALTIME_TIMEOUT_MS=60000
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Voice interaction timing. Keep the two five-second silence settings to preserve natural answer pauses.
VOICE_AUTO_SUBMIT_DELAY_MS=5000
VOICE_TRANSITION_DELAY_MS=750
VOICE_REALTIME_SILENCE_MS=5000
VOICE_REALTIME_WATCHDOG_MS=0
VOICE_MAX_RECOGNITION_RETRIES=8
VOICE_MAX_TRANSCRIPT_CHARACTERS=13200
# Optional: leave blank for in-memory sessions. Set a path only when persistence is intentional.
SQLITE_PATH=
# Optional enhancement only. PDF uploads work without Python through the Node fallback.
# Optional host-specific executable. Leave blank for the Node-only PDF fallback.
# If configured, the executable must have pdfplumber installed for richer research-paper extraction.
DEEPCHAT2LEARN_PYTHON_BIN=
PORT=3000
RATE_LIMIT_PER_MINUTE=120
MAX_ANSWER_CHARACTERS=13200
MAX_QUESTION_CHARACTERS=2200
MAX_REQUEST_BODY_BYTES=28000000
SESSION_RETENTION_MODE=session
SESSION_TTL_MS=3600000
SESSION_SHORT_EXPIRY_MS=900000
SESSION_TURN_BUDGET=50
SESSION_MODEL_TOKEN_BUDGET=132000
MAX_SOURCE_FILES=10
MAX_SOURCE_FILE_BYTES=20000000
MAX_SOURCE_COMBINED_BYTES=50000000
MAX_SOURCE_PAGES=300
MAX_SOURCE_WORDS=150000
MAX_PASTED_SOURCE_CHARACTERS=200000
EXTERNAL_RESEARCH_ENABLED=false
EXTERNAL_RESEARCH_PROVIDER=none
EXTERNAL_RESEARCH_TIMEOUT_MS=4000
EXTERNAL_RESEARCH_CONSENT_TTL_MS=60000
